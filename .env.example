# Server-only integrations. None are required for the launch homepage.
# Never prefix secrets with NEXT_PUBLIC_. Use .env.local for local credentials.
MONGODB_URI=
MONGODB_DATABASE=goodtiming
# Use sandbox or production with the matching eBay credential set.
EBAY_ENVIRONMENT=
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=
EBAY_EPN_CAMPAIGN_ID=
OPENAI_API_KEY=

# Marketplace account deletion: server-only, independent of OAuth credentials.
# Token: 32–80 characters, only A–Z, a–z, 0–9, underscore, and hyphen.
EBAY_MARKETPLACE_DELETION_VERIFICATION_TOKEN=
# Set exactly to https://goodtiming.ca/api/ebay/marketplace-account-deletion
# Use the same exact URL in eBay's notification subscription settings (no trailing slash).
EBAY_MARKETPLACE_DELETION_ENDPOINT=
