# Server-only integrations. None are required for the launch homepage.
# Never prefix secrets with NEXT_PUBLIC_. Use .env.local for local credentials.
MONGODB_URI=
MONGODB_DATABASE=goodtiming
# Use sandbox or production with the matching eBay credential set.
EBAY_ENVIRONMENT=
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=
EBAY_EPN_CAMPAIGN_ID=
OPENAI_API_KEY=
